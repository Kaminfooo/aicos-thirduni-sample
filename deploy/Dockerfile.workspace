FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 YOLO_AUTOINSTALL=false OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.lock.txt backend/requirements.lock.txt
COPY deploy/requirements-hosted.txt deploy/requirements-hosted.txt
RUN python -m pip install --no-cache-dir torch==2.10.0 torchvision==0.25.0 --index-url https://download.pytorch.org/whl/cpu \
 && python -m pip install --no-cache-dir -r deploy/requirements-hosted.txt
COPY . .
RUN python -I -B tools/fetch_reference_models.py
RUN useradd --create-home aicos && chown -R aicos:aicos /app
USER aicos
EXPOSE 10000
CMD ["sh", "-c", "exec python -m uvicorn deploy.judge_workspace:create_app --factory --host 0.0.0.0 --port ${PORT:-10000} --workers 1 --no-access-log"]
