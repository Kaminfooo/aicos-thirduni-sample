# AICOS Government Edition v6 - production-oriented configuration template.
# Copy to .env and replace every REPLACE_* value before first launch.

# Edge/device workers: INGEST events/observations/heartbeats only.
AICOS_API_KEY=REPLACE_WITH_32PLUS_CHAR_DEVICE_KEY

# Control-room authentication.
# Government default: local RBAC accounts. Bootstrap creates the FIRST admin
# only when the user table is empty. Remove the bootstrap password from .env
# immediately after first successful sign-in and restart the service.
AICOS_ALLOW_SHARED_OPERATOR_KEYS=false
AICOS_BOOTSTRAP_ADMIN_USER=aicosadmin
AICOS_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_20PLUS_CHAR_BOOTSTRAP_PASSWORD
AICOS_SESSION_SECONDS=43200
# Expired/revoked session cleanup is throttled and request-driven.
AICOS_SESSION_PURGE_SECONDS=300

# Legacy/pilot shared keys. Leave blank when AICOS_ALLOW_SHARED_OPERATOR_KEYS=false.
AICOS_OPERATOR_KEY=
AICOS_VIEWER_KEY=

# HTTP/Web security. Same-origin dashboards need no CORS entry.
AICOS_CORS_ORIGINS=
# Comma-separated hostnames accepted by the backend, e.g. aicos.gov.local,127.0.0.1
AICOS_TRUSTED_HOSTS=
# true only when TLS terminates at the supplied reverse proxy.
AICOS_BEHIND_HTTPS=true
AICOS_MAX_REQUEST_BYTES=20000000
# Keep URL/query credentials disabled in government deployments.
AICOS_WS_QUERY_TOKEN_ALLOWED=false

# Camera runtime / integrity monitoring.
AICOS_CAMERA_STALE_SECONDS=45
AICOS_INTEGRITY_BASELINE_DIR=/data/integrity-baselines

# Optional AI-polished incident reports. Leave blank for fully offline template mode.
AICOS_LLM_API_KEY=
AICOS_LLM_MODEL=
AICOS_REPORT_LANG=en

# Evidence media retention and upload limits.
SNAPSHOT_RETENTION_DAYS=14
SNAPSHOT_MAX_BYTES=3000000
CLIP_MAX_BYTES=8000000

# Escalation. Default is operator-approved incidents only.
AICOS_NOTIFY_ON=approved
AICOS_NOTIFY_MIN_SEVERITY=4
AICOS_NOTIFY_WEBHOOK_URL=
AICOS_TELEGRAM_BOT_TOKEN=
AICOS_TELEGRAM_CHAT_ID=
AICOS_SMTP_HOST=
AICOS_SMTP_PORT=587
AICOS_SMTP_USER=
AICOS_SMTP_PASSWORD=
AICOS_SMTP_TO=

# Durable VMS/SIEM/dispatch integration bus.
# Multiple HTTPS targets may be comma-separated. HMAC secret should be 32+ random bytes.
AICOS_INTEGRATION_WEBHOOK_URLS=
AICOS_INTEGRATION_HMAC_SECRET=
AICOS_INTEGRATION_STAGES=approved

# Signed offline licensing. For government production deployments, set REQUIRED=true
# and mount the signed license + VENDOR PUBLIC key from protected host volumes.
AICOS_LICENSE_REQUIRED=false
AICOS_LICENSE_FILE=
AICOS_LICENSE_PUBLIC_KEY=
AICOS_MACHINE_ID=

# Per-camera signed assurance certificates.
AICOS_REQUIRE_CAMERA_CERT=false
AICOS_CAMERA_CERT_DIR=
AICOS_CERT_PUBLIC_KEY=

# Deployment-scoped evidence signing. The PRIVATE key belongs to this deployment
# and should ideally be HSM/TPM protected. Never use the vendor licensing key here.
AICOS_EVIDENCE_SIGNING_REQUIRED=false
AICOS_EVIDENCE_PRIVATE_KEY=
AICOS_EVIDENCE_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Durability limits (v6.0.2)
# ---------------------------------------------------------------------------
# Edge outbox. Under storage pressure AICOS removes bulky media first, then
# may evict low-severity (1-3) rows. Severity 4/5 event metadata is protected
# from automatic eviction. Permanent backend rejects are quarantined in a
# dead-letter queue for operator review/replay instead of being deleted.
AICOS_OUTBOX_MAX_MB=256
AICOS_OUTBOX_MAX_ROWS=5000
# Runtime disk reserve. Media compaction/low-severity eviction starts when free
# space falls below this threshold even if the JSON payload budget is not full.
AICOS_OUTBOX_MIN_FREE_MB=512
# Dead-letter budget. Low-severity quarantined events may be pruned under pressure;
# severity 4/5 rows remain protected and keep their snapshot.
AICOS_DLQ_MAX_MB=256
AICOS_DLQ_MAX_ROWS=10000

# Integration bus. A dead webhook URL or a wrong secret never starts working;
# give up rather than retry it forever. Delivered and abandoned rows are kept
# briefly so an operator can see what happened, then pruned.
AICOS_INTEGRATION_MAX_ATTEMPTS=12
AICOS_INTEGRATION_HISTORY_DAYS=7
AICOS_INTEGRATION_MAX_ROWS=50000
